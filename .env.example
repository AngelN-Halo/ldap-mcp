# Copy to .env and set site-specific values; never commit .env.
IDM_LDAP_HOST=ldap.example.org
IDM_LDAP_PORT=636
IDM_LDAP_USE_SSL=true
IDM_BIND_DN=cn=reader,o=example
IDM_BIND_PASSWORD=REPLACE_ME
IDM_SEARCH_BASE=o=example
IDM_USER_FILTER=(objectClass=inetOrgPerson)
IDM_TLS_VALIDATE=true
IDM_CA_CERT_FILE=/certs/your-ca.pem
IDM_DEFAULT_LIMIT=50
IDM_MAX_LIMIT=500
IDM_EXPORT_DEFAULT_LIMIT=1000
IDM_EXPORT_MAX_LIMIT=5000
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
